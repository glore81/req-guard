# Скопируйте этот файл в .env и впишите ключи. Файл .env НЕ коммитить!
#
# Достаточно ключа хотя бы одного провайдера:
#   оба ключа     -> требования проверяет Gemini, противоречия ищет Groq,
#                    при сбое Gemini запросы подхватывает Groq;
#   только Gemini -> всё на Gemini;
#   только Groq   -> всё на Groq.

# Бесплатный ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (бесплатный ключ: https://console.groq.com/keys)
GROQ_API_KEY=

# Необязательно — свои модели вместо стандартных (модели Groq с префиксом "groq:"):
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACKS=gemini-3.5-flash-lite,gemini-3.6-flash,groq:openai/gpt-oss-120b
SET_CHECKER_MODEL=groq:openai/gpt-oss-120b